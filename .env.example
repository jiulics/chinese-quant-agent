# ============================================================
# chinese-quant-agent 环境变量配置示例
# 复制本文件为 .env 并填入你自己的值（.env 已被 git 忽略）
# ============================================================

# ---------- LLM 模型接入（OpenAI 兼容协议） ----------
# 支持任意 OpenAI 兼容服务：DeepSeek / Qwen / vLLM / Ollama / LM Studio 等
# 每个开发者都可以自定义自己的模型，纯本地运行无需联网

# 服务基础地址（OpenAI 兼容接口）
# DeepSeek 官方: https://api.deepseek.com/v1
# Ollama 本地:   http://localhost:11434/v1
# vLLM 本地:     http://localhost:8000/v1
# LM Studio:     http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1

# API Key（本地模型可填任意占位值，如 "ollama" 或 "local"）
LLM_API_KEY=ollama

# 模型名称
# DeepSeek: deepseek-chat
# Ollama:   qwen2.5:7b / deepseek-r1:7b 等
LLM_MODEL=qwen2.5:7b

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---------- 数据源 ----------
# 默认使用 akshare（免费、无需 token）
DATA_PROVIDER=akshare

# ---------- 可选：调试 ----------
LOG_LEVEL=INFO
